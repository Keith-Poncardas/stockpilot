generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    UNASSIGNED
    SUPER_ADMIN
    ADMIN
    MANAGER
    CASHIER
}

enum UserStatus {
    INACTIVE
    ACTIVE
    SUSPENDED
    TERMINATED
}

enum ProductStatus {
    ACTIVE
    INACTIVE
    DISCONTINUED
    DRAFT
    ARCHIVED
}

enum UserApprovalStatus {
    PENDING
    APPROVED
    REJECTED
}

enum MovementType {
    IN
    OUT
    ADJUSTMENT
}

enum SaleStatus {
    PENDING
    COMPLETED
    REFUNDED
    VOIDED
}

model User {
    id             String             @id @default(uuid()) @db.Uuid
    firstName      String             @map("first_name") @db.VarChar
    lastName       String             @map("last_name") @db.VarChar
    email          String             @unique @db.VarChar
    passwordHash   String             @map("password_hash") @db.VarChar
    role           UserRole           @default(UNASSIGNED)
    status         UserStatus         @default(INACTIVE)
    approvalStatus UserApprovalStatus @default(PENDING)
    tokenVersion   Int                @default(0) @map("token_version")
    createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

    sales          Sale[]
    stockMovements StockMovement[]
    passwordReset  PasswordReset?

    @@map("users")
}

model PasswordReset {
    id        String   @id @default(uuid()) @db.Uuid
    email     String   @unique @db.VarChar
    otpHash   String   @map("otp_hash") @db.VarChar
    expiresAt DateTime @map("expires_at") @db.Timestamp(6)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    user User @relation(fields: [email], references: [email], onDelete: Cascade)

    @@map("password_resets")
}

model PendingRegistration {
    id String @id @default(uuid()) @db.Uuid

    firstName String @map("first_name") @db.VarChar
    lastName  String @map("last_name") @db.VarChar
    email     String @unique @db.VarChar

    passwordHash String @map("password_hash") @db.VarChar
    otpHash      String @map("otp_hash") @db.VarChar

    expiresAt DateTime @map("expires_at") @db.Timestamp(6)

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    @@map("pending_registrations")
}

model Product {
    id          String        @id @default(uuid()) @db.Uuid
    sku         String        @unique @db.VarChar
    name        String        @db.VarChar
    description String?       @db.Text
    unitPrice   Decimal       @map("unit_price") @db.Decimal(10, 2)
    costPrice   Decimal?      @map("cost_price") @db.Decimal(10, 2)
    status      ProductStatus @default(DRAFT)
    createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

    inventory      Inventory?
    saleItems      SaleItem[]
    stockMovements StockMovement[]

    @@map("products")
}

model Inventory {
    id             String   @id @default(uuid()) @db.Uuid
    productId      String   @unique @map("product_id") @db.Uuid
    quantityOnHand Int      @default(0) @map("quantity_on_hand")
    reorderLevel   Int      @default(10) @map("reorder_level")
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    product Product @relation(fields: [productId], references: [id])

    // Prevents negative stock at the DB level — enforce via migration:
    // ALTER TABLE inventory ADD CONSTRAINT chk_qty_non_negative CHECK (quantity_on_hand >= 0);

    @@map("inventory")
}

model Customer {
    id        String   @id @default(uuid()) @db.Uuid
    firstName String?  @map("first_name") @db.VarChar
    lastName  String?  @map("last_name") @db.VarChar
    phone     String?  @unique @db.VarChar
    email     String?  @unique @db.VarChar
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    sales Sale[]

    @@map("customers")
}

model Sale {
    id            String     @id @default(uuid()) @db.Uuid
    customerId    String?    @map("customer_id") @db.Uuid
    userId        String     @map("user_id") @db.Uuid
    status        SaleStatus @default(COMPLETED)
    totalAmount   Decimal    @map("total_amount") @db.Decimal(10, 2)
    paymentMethod String?    @map("payment_method") @db.VarChar
    saleDate      DateTime   @default(now()) @map("sale_date") @db.Timestamp(6)
    createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

    customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
    user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
    saleItems SaleItem[]

    @@index([userId])
    @@index([customerId])
    @@index([saleDate])
    @@map("sales")
}

model SaleItem {
    id        String  @id @default(uuid()) @db.Uuid
    saleId    String  @map("sale_id") @db.Uuid
    productId String  @map("product_id") @db.Uuid
    quantity  Int
    unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

    // subtotal removed — compute as (quantity * unitPrice) at query time
    // to avoid quantity/price going out of sync with a stored value

    sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

    @@index([saleId])
    @@index([productId])
    @@map("sale_items")
}

model StockMovement {
    id        String       @id @default(uuid()) @db.Uuid
    productId String       @map("product_id") @db.Uuid
    userId    String       @map("user_id") @db.Uuid
    type      MovementType
    quantity  Int
    reference String?      @db.VarChar
    notes     String?      @db.Text
    createdAt DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
    deletedAt DateTime?    @map("deleted_at") @db.Timestamp(6)

    product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
    user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

    @@index([productId])
    @@index([userId])
    @@index([type])
    @@map("stock_movements")
}
