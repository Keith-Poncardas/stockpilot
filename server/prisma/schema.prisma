generator client {
    provider = "prisma-client"
    output   = "../src/generated"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    UNASSIGNED
    SUPER_ADMIN
    ADMIN
    MANAGER
    CASHIER
}

enum UserStatus {
    INACTIVE
    ACTIVE
    SUSPENDED
    TERMINATED
}

enum ProductStatus {
    ACTIVE
    INACTIVE
    DISCONTINUED
    DRAFT
    ARCHIVED
}

enum ProductType {
    SIMPLE
    BUNDLE
}

enum UserApprovalStatus {
    PENDING
    APPROVED
    REJECTED
}

enum MovementType {
    IN
    OUT
    ADJUSTMENT
}

enum MovementReason {
    SALE
    PURCHASE
    ADJUSTMENT
    RETURN
    DAMAGE
    EXPIRED
    TRANSFER
    INITIAL_STOCK
}

enum SaleStatus {
    PENDING
    COMPLETED
    REFUNDED
    VOIDED
}

enum PaymentMethod {
    CASH
    GCASH
    BANK_TRANSFER
    CREDIT_CARD
    DEBIT_CARD
}

model User {
    id             String             @id @default(uuid()) @db.Uuid
    firstName      String             @map("first_name") @db.VarChar
    lastName       String             @map("last_name") @db.VarChar
    email          String             @unique @db.VarChar
    passwordHash   String             @map("password_hash") @db.VarChar
    role           UserRole           @default(UNASSIGNED)
    status         UserStatus         @default(INACTIVE)
    approvalStatus UserApprovalStatus @default(PENDING)
    tokenVersion   Int                @default(0) @map("token_version")
    createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

    sales          Sale[]
    stockMovements StockMovement[]
    passwordReset  PasswordReset?
    inventories    Inventory[]

    @@map("users")
}

model PasswordReset {
    id        String   @id @default(uuid()) @db.Uuid
    email     String   @unique @db.VarChar
    otpHash   String   @map("otp_hash") @db.VarChar
    expiresAt DateTime @map("expires_at") @db.Timestamp(6)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    user User @relation(fields: [email], references: [email], onDelete: Cascade)

    @@map("password_resets")
}

model PendingRegistration {
    id String @id @default(uuid()) @db.Uuid

    firstName String @map("first_name") @db.VarChar
    lastName  String @map("last_name") @db.VarChar
    email     String @unique @db.VarChar

    passwordHash String @map("password_hash") @db.VarChar
    otpHash      String @map("otp_hash") @db.VarChar

    expiresAt DateTime @map("expires_at") @db.Timestamp(6)

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    @@map("pending_registrations")
}

model Product {
    id           String        @id @default(uuid()) @db.Uuid
    sku          String        @unique @db.VarChar
    name         String        @db.VarChar
    description  String?       @db.Text
    imageUrl     String?       @map("image_url") @db.VarChar
    imagePublicId String?      @map("image_public_id") @db.VarChar
    unitPrice    Decimal       @map("unit_price") @db.Decimal(10, 2)
    costPrice    Decimal?      @map("cost_price") @db.Decimal(10, 2)
    regularPrice Decimal?      @map("regular_price") @db.Decimal(10, 2)
    productType  ProductType   @default(SIMPLE) @map("product_type")
    status       ProductStatus @default(DRAFT)
    createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

    inventory      Inventory?
    saleItems      SaleItem[]
    stockMovements StockMovement[]
    bundleItems    ProductBundleItem[]  @relation("ParentProductBundles")
    bundledIn      ProductBundleItem[]  @relation("BundledProducts")
    pricingTiers   ProductPricingTier[] @relation("ProductPricingTiers")
    tieredFreeIn   ProductPricingTier[] @relation("TierFreeProduct")

    @@map("products")
}

model Inventory {
    id               String @id @default(uuid()) @db.Uuid
    productId        String @unique @map("product_id") @db.Uuid
    userId           String @map("user_id") @db.Uuid
    quantityOnHand   Int    @default(0) @map("quantity_on_hand")
    quantityReserved Int    @default(0) @map("quantity_reserved")

    reorderLevel Int      @default(10) @map("reorder_level")
    maxStock     Int      @default(100) @map("max_stock")
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

    author  User    @relation(fields: [userId], references: [id])
    product Product @relation(fields: [productId], references: [id])

    // Prevents negative stock at the DB level — enforce via migration:
    // ALTER TABLE inventory ADD CONSTRAINT chk_qty_non_negative CHECK (quantity_on_hand >= 0);

    @@map("inventory")
}

model Customer {
    id           String   @id @default(uuid()) @db.Uuid
    firstName    String?  @map("first_name") @db.VarChar
    lastName     String?  @map("last_name") @db.VarChar
    phone        String?  @unique @db.VarChar
    email        String?  @unique @db.VarChar
    addressLine1 String?  @map("address_line1") @db.VarChar
    addressLine2 String?  @map("address_line2") @db.VarChar
    city         String?  @db.VarChar
    province     String?  @db.VarChar
    barangay     String?  @db.VarChar
    postalCode   String?  @map("postal_code") @db.VarChar
    country      String?  @default("Philippines") @db.VarChar
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    sales Sale[]

    @@map("customers")
}

model Sale {
    id            String         @id @default(uuid()) @db.Uuid
    customerId    String?        @map("customer_id") @db.Uuid
    userId        String         @map("user_id") @db.Uuid
    status        SaleStatus     @default(COMPLETED)
    totalAmount    Decimal        @map("total_amount") @db.Decimal(10, 2)
    vatableSales   Decimal        @default(0) @map("vatable_sales") @db.Decimal(10, 2)
    vatAmount      Decimal        @default(0) @map("vat_amount") @db.Decimal(10, 2)
    vatExemptSales Decimal        @default(0) @map("vat_exempt_sales") @db.Decimal(10, 2)
    zeroRatedSales Decimal        @default(0) @map("zero_rated_sales") @db.Decimal(10, 2)
    taxRate        Decimal        @default(0.12) @map("tax_rate") @db.Decimal(4, 2)
    paymentMethod  PaymentMethod? @map("payment_method")
    saleDate      DateTime       @default(now()) @map("sale_date") @db.Timestamp(6)
    createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)

    customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
    user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
    saleItems SaleItem[]

    @@index([userId])
    @@index([customerId])
    @@index([saleDate])
    @@map("sales")
}

model SaleItem {
    id        String  @id @default(uuid()) @db.Uuid
    saleId    String  @map("sale_id") @db.Uuid
    productId String  @map("product_id") @db.Uuid
    quantity  Int
    unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
    sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
    product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

    @@index([saleId])
    @@index([productId])
    @@map("sale_items")
}

model StockMovement {
    id        String         @id @default(uuid()) @db.Uuid
    productId String         @map("product_id") @db.Uuid
    userId    String         @map("user_id") @db.Uuid
    type      MovementType
    quantity  Int
    reference String?        @db.VarChar
    notes     String?        @db.Text
    createdAt DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
    reason    MovementReason @default(INITIAL_STOCK)

    product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
    user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

    @@index([productId])
    @@index([userId])
    @@index([type])
    @@map("stock_movements")
}

model ProductBundleItem {
    id               String   @id @default(uuid()) @db.Uuid
    parentProductId  String   @map("parent_product_id") @db.Uuid
    bundledProductId String   @map("bundled_product_id") @db.Uuid
    quantity         Int      @default(1)
    createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    parentProduct  Product @relation("ParentProductBundles", fields: [parentProductId], references: [id], onDelete: Cascade)
    bundledProduct Product @relation("BundledProducts", fields: [bundledProductId], references: [id], onDelete: Restrict)

    @@unique([parentProductId, bundledProductId])
    @@index([parentProductId])
    @@index([bundledProductId])
    @@map("product_bundle_items")
}

model ProductPricingTier {
    id            String   @id @default(uuid()) @db.Uuid
    productId     String   @map("product_id") @db.Uuid
    minQuantity   Int      @map("min_quantity")
    maxQuantity   Int?     @map("max_quantity")
    tierPrice     Decimal  @map("tier_price") @db.Decimal(10, 2)
    freeProductId String?  @map("free_product_id") @db.Uuid
    freeQuantity  Int      @default(0) @map("free_quantity")
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

    product     Product  @relation("ProductPricingTiers", fields: [productId], references: [id], onDelete: Cascade)
    freeProduct Product? @relation("TierFreeProduct", fields: [freeProductId], references: [id], onDelete: SetNull)

    @@index([productId])
    @@index([freeProductId])
    @@map("product_pricing_tiers")
}
